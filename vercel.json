{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sounds/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true },
    { "source": "/prompts", "destination": "/suggestions", "permanent": true },
    { "source": "/emotion", "destination": "/suggestions", "permanent": true },
    { "source": "/variants", "destination": "/constraints", "permanent": true },
    { "source": "/replay", "destination": "/constraints", "permanent": true },
    { "source": "/principles", "destination": "/facts", "permanent": true },
    { "source": "/genres", "destination": "/facts", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/__spa-fallback.html" }
  ]
}
